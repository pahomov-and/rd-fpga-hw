<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="led_counter_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="led_counter" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns"></ZoomStartTime>
      <ZoomEndTime time="410.001 ns"></ZoomEndTime>
      <Cursor1Time time="410.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="193"></NameColumnWidth>
      <ValueColumnWidth column_width="179"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="4" />
   <wvobject type="logic" fp_name="/led_counter/clock">
      <obj_property name="ElementShortName">clock</obj_property>
      <obj_property name="ObjectShortName">clock</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/led_counter/reset">
      <obj_property name="ElementShortName">reset</obj_property>
      <obj_property name="ObjectShortName">reset</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/led_counter/leds">
      <obj_property name="ElementShortName">leds[3:0]</obj_property>
      <obj_property name="ObjectShortName">leds[3:0]</obj_property>
      <obj_property name="Radix">BINARYRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/led_counter/cnt">
      <obj_property name="ElementShortName">cnt[3:0]</obj_property>
      <obj_property name="ObjectShortName">cnt[3:0]</obj_property>
   </wvobject>
</wave_config>
